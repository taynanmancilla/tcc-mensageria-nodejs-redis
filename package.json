{
  "name": "tcc-mensageria-nodejs-redis",
  "version": "0.1.0",
  "description": "Avaliação comparativa de modelos de mensageria P2P e Pub/Sub com Node.js e Redis",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "prototype:basic": "node src/prototypes/basic.js",
    "scenario:c1": "node src/load-runner/run.js c1-baseline",
    "scenario:c2": "node src/load-runner/run.js c2-fila-tarefas",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "prom-client": "^15.1.3",
    "redis": "^4.6.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "MIT"
}
